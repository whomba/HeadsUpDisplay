# Server Configuration
PORT=3000
NODE_ENV=development

# Weather API
# Get your API key from: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_PROVIDER=openweathermap

# Weather Locations
PRIMARY_ZIP=98133
SECONDARY_LOCATION=Quilcene,WA

# Google Calendar API
# Setup: https://developers.google.com/calendar/api/quickstart/nodejs
GOOGLE_CALENDAR_CLIENT_ID=your_google_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_client_secret_here

# Google Maps API (for Traffic)
# Setup: https://developers.google.com/maps/documentation/directions/overview
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# RSS Feeds (comma-separated URLs)
RSS_FEEDS=https://news.ycombinator.com/rss,https://example.com/feed

# Cache Settings (in seconds)
CACHE_TTL_WEATHER=600    # 10 minutes
CACHE_TTL_CALENDAR=300   # 5 minutes
CACHE_TTL_RSS=900        # 15 minutes

# Optional: Air Quality API
# Get key from: https://docs.airnow.gov/account/request/
AIRNOW_API_KEY=your_airnow_api_key_here
